# .env.example — the ONE place that declares every setting the system needs.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. This file is committed and must never contain real secrets.
#
# Rule: if your code reads a new setting, add it here in the same PR,
# with a comment (on its own line) saying what it is, and a safe placeholder value.

# ── App ─────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Backend ─────────────────────────────────────────────
API_PORT=8000
# e.g. mongodb://user:pass@localhost:27017/app?authSource=admin
DATABASE_URL=change-me

# ── External services (examples — delete what you don't use) ─
# NASA_FIRMS_MAP_KEY=change-me
# FCM_SERVER_KEY=change-me

# ── ML ──────────────────────────────────────────────────
# Which released model version the backend loads (see docs/05)
# MODEL_VERSION=v0.1.0
